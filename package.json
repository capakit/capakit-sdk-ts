{
    "name": "@capakit/sdk",
    "version": "0.0.6",
    "description": "TypeScript SDK for CapaKit Workloads.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/capakit/capakit-sdk-ts.git"
    },
    "bugs": {
        "url": "https://github.com/capakit/capakit-sdk-ts/issues"
    },
    "homepage": "https://github.com/capakit/capakit-sdk-ts#readme",
    "type": "module",
    "files": [
        "src"
    ],
    "exports": {
        ".": {
            "types": "./src/index-types.ts",
            "default": "./src/index.ts"
        },
        "./a2a": {
            "types": "./src/provider-types/a2a.ts",
            "default": "./src/a2a.ts"
        },
        "./anthropic": {
            "types": "./src/provider-types/anthropic.ts",
            "default": "./src/anthropic.ts"
        },
        "./google-ai-studio": {
            "types": "./src/provider-types/google-ai-studio.ts",
            "default": "./src/google-ai-studio.ts"
        },
        "./mcp": {
            "types": "./src/provider-types/mcp.ts",
            "default": "./src/mcp.ts"
        },
        "./oaic": {
            "types": "./src/provider-types/oaic.ts",
            "default": "./src/oaic.ts"
        },
        "./public-types": {
            "types": "./src/public-types.ts",
            "default": "./src/public-types.ts"
        },
        "./testing": {
            "types": "./src/provider-types/testing.ts",
            "default": "./src/testing.ts"
        },
        "./websocket": {
            "types": "./src/provider-types/websocket.ts",
            "default": "./src/websocket.ts"
        }
    },
    "scripts": {
        "audit": "npm audit --audit-level=moderate",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "check": "npm run audit && npm run typecheck && npm test",
        "pack:dry-run": "npm pack --dry-run",
        "render:agents-md-types": "node scripts/render-agents-md-types.mjs",
        "dev-release": "scripts/dev-release.sh",
        "release": "scripts/release.sh"
    },
    "dependencies": {},
    "peerDependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@a2a-js/sdk": "^0.3.13",
        "@anthropic-ai/sdk": "^0.100.1",
        "@google/genai": "^2.7.0",
        "openai": "^6.41.0",
        "ws": "^8.21.0"
    },
    "peerDependenciesMeta": {
        "@modelcontextprotocol/sdk": {
            "optional": true
        },
        "@a2a-js/sdk": {
            "optional": true
        },
        "@anthropic-ai/sdk": {
            "optional": true
        },
        "@google/genai": {
            "optional": true
        },
        "openai": {
            "optional": true
        },
        "ws": {
            "optional": true
        }
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.29.0",
        "@a2a-js/sdk": "^0.3.13",
        "@anthropic-ai/sdk": "^0.100.1",
        "@google/genai": "^2.7.0",
        "@types/node": "25.9.1",
        "@types/ws": "^8.18.1",
        "openai": "^6.41.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.8",
        "ws": "^8.21.0"
    }
}
